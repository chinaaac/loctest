#!name=位置上传改写
#!desc=改写 zl.wohenizaiyiqi.com 的 bundleV2 定位字段
#!system=ios

[Script]
位置上传改写 = type=http-request,pattern=^https:\/\/zl\.wohenizaiyiqi\.com\/(?:User|Lbs)\/,script-path=https://raw.githubusercontent.com/chinaaac/loctest/refs/heads/main/location_rewrite.js,requires-body=true,max-size=0,timeout=10

[MITM]
hostname = %APPEND% zl.wohenizaiyiqi.com
